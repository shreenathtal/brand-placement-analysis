GEMINI_API_KEY=your-api-key-here
# Default matches Gemini Flash Lite tier (higher free-tier quota than plain Flash).
# GEMINI_MODEL=gemini-3.1-flash-lite
# Free tier is ~15 generateContent requests per rolling minute (not just spacing).
# GEMINI_MIN_INTERVAL_MS=5000
# GEMINI_MAX_REQUESTS_PER_MINUTE=10
# Optional placement sentiment vision call (UI checkbox; default off)
# RUN_PLACEMENT_SENTIMENT=true
# Google Search grounding (off by default; enable only with billing headroom)
# ENABLE_GOOGLE_SEARCH=true
# GEMINI_MAX_QUOTA_RETRIES=1
